# Placeholders para desenvolvimento local do PsiqApp.
# Copie para .env e substitua os valores localmente. Nao use dados reais de pacientes neste MVP.

POSTGRES_DB=psiqapp_dev
POSTGRES_USER=psiqapp_dev
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-terra

# Padroes locais de runtime do backend previstos pela TechSpec.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

PSIQAPP_ANALISE_WORKER_ENABLED=false
PSIQAPP_ANALISE_PROVIDER=fake
PSIQAPP_ANALISE_WORKER_POLL_INTERVAL=2s
PSIQAPP_ANALISE_CALL_TIMEOUT=120s
PSIQAPP_ANALISE_ATTEMPT_BUDGET=180s
PSIQAPP_ANALISE_LEASE_TTL=240s
PSIQAPP_ANALISE_MAX_ATTEMPTS=3
PSIQAPP_ANALISE_BACKOFF_INITIAL=5s
PSIQAPP_ANALISE_BACKOFF_FINAL=20s

# Opcional: integração server-side com Google Agenda.
# A chave deve ser Base64 de 32 bytes aleatórios; mantenha-a fora do Git.
PSIQAPP_GOOGLE_AGENDA_CLIENT_ID=replace-with-google-oauth-client-id
PSIQAPP_GOOGLE_AGENDA_CLIENT_SECRET=replace-with-google-oauth-client-secret
PSIQAPP_GOOGLE_AGENDA_REDIRECT_URI=http://127.0.0.1:8080/api/v1/integracoes/google-agenda/callback
PSIQAPP_GOOGLE_AGENDA_FRONTEND_URI=http://127.0.0.1:5173/agenda
PSIQAPP_GOOGLE_AGENDA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PSIQAPP_GOOGLE_AGENDA_WORKER_ENABLED=true
PSIQAPP_GOOGLE_AGENDA_WORKER_POLL_INTERVAL=5s
