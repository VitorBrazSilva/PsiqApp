# Placeholders para desenvolvimento local do PsiqApp.
# Copie para .env e substitua os valores localmente. Nao use dados reais de pacientes neste MVP.

POSTGRES_DB=psiqapp_dev
POSTGRES_USER=psiqapp_dev
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-terra

# Padroes locais de runtime do backend previstos pela TechSpec.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

AI_WORKER_POLL_INTERVAL_SECONDS=2
AI_PROVIDER_TIMEOUT_SECONDS=120
AI_ATTEMPT_BUDGET_SECONDS=180
AI_LEASE_TTL_SECONDS=240
AI_MAX_ATTEMPTS=3
